# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*

# openspec changes
/openspec/changes
# openspec specs (generated from changes, should not be committed)
/openspec/specs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts